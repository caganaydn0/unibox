# ============================================================
# UniBox — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env dosyasını ASLA git'e commit'lemeyin (KVKK).
# ============================================================

# --- Genel ---
APP_ENV=development           # development | production
SECRET_KEY=CHANGE_ME_RANDOM_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# --- Veritabanı (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unibox

# --- KVKK: Fernet şifreleme anahtarı (collected_fields_enc için) ---
# Üretmek için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_FERNET_KEY

# --- LLM Backend ---
# llama_cpp: Doğrudan GGUF yükler (GPU'suz sunucularda iyi)
# ollama: Ollama REST API'sini kullanır (http://localhost:11434)
UNIBOX_LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# llama_cpp için:
LLAMA_CPP_MODEL_PATH=./models/llama-3.1-8b.gguf
LLAMA_CPP_N_CTX=8192
LLAMA_CPP_N_GPU_LAYERS=0

# --- Embedding (RAG — pgvector) ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- SMTP ---
SMTP_BACKEND=console       # "console" (dev) | "smtp" (prod)
SMTP_HOST=localhost
SMTP_PORT=1025             # Prod için: 587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=unibox@university.edu.tr
SMTP_FROM_NAME=UniBox Asistan
SMTP_USE_TLS=false         # Prod için: true
SMTP_MAX_RETRIES=3

# --- Uploads (PDF'ler DB'de BYTEA olarak saklanır) ---
MAX_UPLOAD_SIZE_MB=20

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Veri Saklama (KVKK) ---
CONVERSATION_RETENTION_DAYS=90
EMAIL_LOG_RETENTION_DAYS=180

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30   # saniye

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
