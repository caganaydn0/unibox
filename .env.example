# ============================================================
# UniBox — Ortam Değişkenleri Şablonu
#
# İKİ AYRI DOSYA GEREKİYOR:
#   1) backend/.env   — bu şablonun tamamı (uygulama ayarları)
#   2) ./.env         — yalnızca POSTGRES_PASSWORD (docker-compose okur)
#   3) frontend/.env.local — ayrı şablon: frontend/.env.local.example
#
# Kurulum:
#   cp .env.example backend/.env
#   echo "POSTGRES_PASSWORD=<güçlü-parola>" > .env
#   cp frontend/.env.local.example frontend/.env.local
#
# .env dosyalarını ASLA git'e commit'lemeyin (KVKK).
# ============================================================

# --- Genel ---
APP_ENV=development           # development | production
                              # production: /docs ve /redoc kapanır
SECRET_KEY=CHANGE_ME_RANDOM_32_CHARS
ADMIN_USERNAME=admin

# Parola İKİ biçimde verilebilir. Hash tanımlıysa düz metin YOK SAYILIR.
#
# ÜRETİMDE ADMIN_PASSWORD_HASH ZORUNLU — düz metin parola ortam
# değişkeninde durursa süreç listesinden ve yedeklerden okunabilir.
# Üretmek için:
#   cd backend && uv run python -c \
#     "from app.core.security import hash_password; print(hash_password('parolanız'))"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=CHANGE_ME

# CORS — virgülle ayrılmış origin listesi. Boş bırakılırsa development'ta
# http://localhost:3000 varsayılır, üretimde hiçbir origin açılmaz.
# Tarayıcı istekleri normalde Next.js BFF proxy'sinden geçtiği için CORS
# devreye girmez; bu liste doğrudan erişim senaryoları içindir.
#   CORS_ORIGINS=https://unibox.universite.edu.tr
CORS_ORIGINS=

# --- Veritabanı (PostgreSQL + pgvector) ---
# Parola, kök dizindeki .env içindeki POSTGRES_PASSWORD ile AYNI olmalı.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/unibox

# Connection pool — üretimde eşzamanlı admin+worker sayısına göre ayarlayın.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# --- KVKK: Fernet şifreleme anahtarı ---
# collected_fields_enc ve sender_email_enc bu anahtarla şifrelenir.
# Üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# DİKKAT: Bu anahtarı kaybederseniz veritabanındaki tüm şifreli veri
# kalıcı olarak okunamaz hale gelir. Yedekleyin ve ASLA yeniden üretmeyin.
FERNET_KEY=CHANGE_ME_FERNET_KEY

# --- LLM Backend ---
# ollama:    Ollama REST API'sini kullanır (önerilen)
# llama_cpp: Doğrudan GGUF yükler (GPU'suz sunucularda iyi)
UNIBOX_LLM_BACKEND=ollama

# Host'ta kurulu Ollama: 11434. docker-compose'daki container: 11435.
# Hangisini kullanırsanız, llama3.1:8b VE bge-m3 orada yüklü olmalı:
#   ollama pull llama3.1:8b && ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Ollama'nın varsayılanı (2048) RAG bağlamını sessizce kırpıp uydurmaya yol
# açıyordu — düşürmeyin. LLAMA_CPP_N_CTX ile aynı değer.
OLLAMA_NUM_CTX=8192

# llama_cpp için:
LLAMA_CPP_MODEL_PATH=./models/llama-3.1-8b.gguf
LLAMA_CPP_N_CTX=8192
LLAMA_CPP_N_GPU_LAYERS=0

# --- Embedding / RAG (pgvector) ---
# bge-m3 çok dilli. nomic-embed-text ağırlıklı İngilizce eğitildiği için
# Türkçe sorularda zayıf kalıyordu.
#
# MODELİ VEYA BOYUTU DEĞİŞTİRİRSENİZ:
#   1) yeni Alembic migration ile document_chunks.embedding kolonunu güncelle
#   2) cd backend && uv run python ../scripts/reindex_documents.py
# Aksi halde RAG hiçbir sonuç döndürmez.
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

RAG_CHUNK_SIZE=500            # chunk boyutu (karakter = değer x 5)
RAG_CHUNK_OVERLAP=50          # örtüşme (karakter = değer x 5)
RAG_TOP_K=7                   # LLM'e verilecek chunk sayısı

# Kapsam dışı soru eşiği (kosinüs mesafesi). En yakın chunk bu değerden
# uzaksa soru bilgi tabanının dışında sayılır ve LLM'e hiç bağlam verilmez.
# 0.60'ta ölçülen geri getirim kaybı yok; asıl savunma hattı prompt.
# Kalibrasyon tablosu için: backend/app/config.py
RAG_MAX_DISTANCE=0.60

# --- SMTP (giden e-posta) ---
# console: stdout'a basar, gerçekten göndermez
# smtp:    gerçek gönderim. Dev'de MailHog (docker-compose) → port 1025,
#          gelen kutusu http://localhost:8025
SMTP_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=1025                # Prod için: 587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=unibox@university.edu.tr
SMTP_FROM_NAME=UniBox Asistan
SMTP_USE_TLS=false            # Prod için: true
SMTP_MAX_RETRIES=3

# --- IMAP (gelen e-posta akışı) ---
# disabled: IMAP worker hiç başlamaz
# imap:     mailbox düzenli aralıklarla taranır
IMAP_BACKEND=disabled
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=                # Gmail için App Password
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=30
IMAP_MAX_FETCH_PER_POLL=10

# --- Dosya yükleme (PDF'ler DB'de BYTEA olarak saklanır) ---
MAX_UPLOAD_SIZE_MB=20

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Veri saklama (KVKK) — tasks/retention.py günlük uygular ---
CONVERSATION_RETENTION_DAYS=90
EMAIL_LOG_RETENTION_DAYS=180
INCOMING_EMAIL_RETENTION_DAYS=180

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30      # saniye
